{
  "name": "gratis-core",
  "productName": "Gratis Core",
  "version": "0.4.2",
  "private": true,
  "description": "Independent desktop assistants with local memory, scheduled tasks and optional connected apps",
  "author": "Prompt Advisers",
  "type": "module",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "test:desktop": "node test/community-desktop.mjs",
    "test:ui": "node test/ui-polish.mjs",
    "setup:win": "node scripts/setup-win.mjs",
    "setup:assets": "node scripts/setup-assets.mjs",
    "setup:whisper:win": "node scripts/setup-whisper-win.mjs",
    "verify:public": "node scripts/verify-public.mjs",
    "package:mac": "node scripts/package.mjs",
    "check": "npm run verify:public && npm test",
    "package:dmg": "node scripts/package-dmg.mjs",
    "icons:win": "node scripts/make-ico.mjs",
    "build:win": "node scripts/make-ico.mjs && electron-builder --win --x64 --dir",
    "dist:win": "node scripts/make-ico.mjs && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.promptadvisers.gratis.core",
    "productName": "Gratis Core",
    "directories": {
      "output": "dist"
    },
    "artifactName": "Gratis-Core-${version}-win-${arch}.${ext}",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "package.json",
      "edition.json",
      "src/**/*",
      "!assets/**",
      "!node_modules/@openai/codex-win32-x64/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/onnxruntime-node/**",
      "node_modules/@img/**",
      "node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/**"
    ],
    "extraResources": [
      {
        "from": "assets/models",
        "to": "models"
      },
      {
        "from": "assets",
        "to": ".",
        "filter": [
          "composio-cli/**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/gratis.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@electron/osx-sign": "2.7.2",
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.65.0",
    "electron": "42.11.16",
    "electron-builder": "^26.18.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@composio/core": "0.28.0",
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openai/codex-sdk": "0.167.0",
    "@slack/socket-mode": "3.1.1",
    "croner": "11.0.0",
    "dompurify": "3.4.17",
    "linkedom": "0.18.15",
    "marked": "18.1.3",
    "zod": "4.6.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promptadvisers/gratis.git"
  },
  "homepage": "https://github.com/promptadvisers/gratis",
  "bugs": {
    "url": "https://github.com/promptadvisers/gratis/issues"
  }
}
